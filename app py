@app.route("/download_report")
def download_report():

    file_path = "interview_report.pdf"

    styles = getSampleStyleSheet()

    content = []

    content.append(Paragraph("AI Interview Report", styles['Title']))
    content.append(Spacer(1,20))

    content.append(Paragraph("Candidate Name : Arvind Yadav", styles['Normal']))
    content.append(Paragraph("Total Questions : 20", styles['Normal']))
    content.append(Paragraph("Average Score : 7.5 / 10", styles['Normal']))

    content.append(Spacer(1,20))

    content.append(Paragraph("Performance : Good", styles['Normal']))

    content.append(Spacer(1,20))

    content.append(Paragraph(
    "Suggestion : Improve explanation of technical answers.",
    styles['Normal']))

    pdf = SimpleDocTemplate(file_path)

    pdf.build(content)

    return send_file(file_path, as_attachment=True)


